# Discord Bot Authorization Token
# Retrieve from https://discord.com/developers/applications
TOKEN=your_bot_token_here

# PostgreSQL Database Connection URL (required by Drizzle ORM)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kl0

# Target Discord Server (Guild) ID for instant development slash command registration (Optional)
# If left unset, commands will only be registered globally
GUILD_ID=

# Server / Container port (defaults to 9000 in Dockerfile / compose.yaml)
PORT=9000
